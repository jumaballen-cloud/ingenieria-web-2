  "item": [
    {
      "name": "Catálogo de videojuegos",
      "request": {
        "method": "GET",
        "url": "https://dummyjson.com/c/1a95-2677-4c69-9178"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const payload = pm.response.json();",
              "pm.test(\"Seis títulos únicos\", () => pm.expect(new Set(payload.products.map(p=>p.id)).size).to.equal(6));",
              "pm.test(\"Campos de producto\", () => payload.products.forEach(p => pm.expect(p).to.include.all.keys(\"id\",\"title\",\"category\",\"description\",\"price\",\"thumbnail\")));"
            ]
          }
        }
      ]
    },
